# Copy this file to ".env" and fill in the real value.
# The .env file is git-ignored and must NEVER be committed.
#
# Get this key from an existing Trulioo/Anthropic account if one exists
# (check with your manager/IT first — see Section 11 of the brief),
# otherwise from https://console.anthropic.com/ -> Settings -> API Keys.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: pin a default model. Leave unset to use the app default.
# ANTHROPIC_MODEL=claude-opus-4-8

# Optional: S3 storage for the lookup table.
# When set, the lookup is read from and written to S3 instead of a local file.
# This enables the lookup to persist across Streamlit Community Cloud restarts.
# Request an S3 bucket from DevOps (AWS Playground) and create an IAM user with
# s3:GetObject and s3:PutObject permissions on that bucket.
# Leave all four unset to keep using the local data/master_lookup.json file.
# S3_BUCKET_NAME=trulioo-standardization-lookup
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_REGION=us-east-1
